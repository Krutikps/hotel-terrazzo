# Copy to .env and fill in. Never commit .env.

# --- Django -------------------------------------------------------------
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000
TIME_ZONE=Asia/Kolkata
SECURE_COOKIES=false
SECURE_SSL_REDIRECT=false
BEHIND_PROXY=false
LOG_LEVEL=INFO
DISABLE_RATE_LIMITS=false
# Optional shared cache (recommended in production so rate limits work across workers)
REDIS_URL=

# --- Database -------------------------------------------------------------
# sqlite (default, local dev) or postgres (production)
DB_ENGINE=sqlite
DB_NAME_SQLITE=db.sqlite3
DB_NAME=terrazzo
DB_USER=terrazzo
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Payments -------------------------------------------------------------
# mock = built-in sandbox gateway (development only) | razorpay
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOCK_PAYMENT_SECRET=

# --- Email ----------------------------------------------------------------
# Development prints emails to the console. For SMTP use django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Hotel Terrazzo Suites <reservations@example.com>

# --- SMS / WhatsApp (Twilio) -------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# --- Deployment (Render + Neon, see DEPLOY.md) ---------------------------------
# DATABASE_URL overrides the DB_* settings above, e.g. postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Enables /api/cron/holds/ and /api/cron/daily/ for an external scheduler. Leave empty to disable.
CRON_SECRET=
# Used by `manage.py bootstrap_site` on deploy
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=false
SEED_DEMO=false
